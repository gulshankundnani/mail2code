{
  "name": "@mail2code/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "build:all": "wxt build && wxt build -b edge && wxt build -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:all": "wxt zip && wxt zip -b edge && wxt zip -b firefox --mv3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@mail2code/analysis": "0.0.0",
    "@mail2code/backup": "0.0.0",
    "@mail2code/gmail-extract": "0.0.0",
    "@mail2code/protocol": "0.0.0",
    "@mail2code/task-core": "0.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "wxt": "0.21.4"
  },
  "license": "MIT"
}
