{
  "name": "@inbox-handoff/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "build:all": "wxt build && wxt build -b edge && wxt build -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3"
  },
  "dependencies": {
    "@inbox-handoff/gmail-extract": "0.0.0",
    "@inbox-handoff/protocol": "0.0.0",
    "zod": "4.6.7",
    "@inbox-handoff/backup": "0.0.0",
    "@inbox-handoff/task-core": "0.0.0"
  },
  "devDependencies": {
    "wxt": "0.21.4"
  }
}
