{
  "name": "mail2code",
  "private": true,
  "description": "Browser extension: send a Gmail conversation you choose to Claude, with a recorded approval step. Working name.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/gmail-extract/tsconfig.json && npm run -w @mail2code/extension typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run -w @mail2code/extension build:all && playwright test",
    "check:manifests": "node scripts/check-manifests.mjs",
    "scan:secrets": "node --disable-warning=ExperimentalWarning scripts/scan-secrets.mjs",
    "licenses": "node scripts/license-inventory.mjs",
    "licenses:check": "node scripts/license-inventory.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
